+class _ZeroPadCore(torch.nn.Module):
+    """Wraps an EINet and zero-pads its output to ``pad_to`` dimensions.
+
+    Used when the EINet excitatory layer size is smaller than the downstream
+    decoder's expected input dim (e.g. EINet(2048) → fc8(4096→1000)).
+    All submodules remain accessible via standard nn.Module iteration so
+    parameter grouping (TopKLinear, BlockLinear, etc.) works unchanged.
+    """
+
+    def __init__(self, core: torch.nn.Module, pad_to: int) -> None:
+        super().__init__()
+        self.core = core
+        self.output_dim = pad_to
+        self._pad_to = pad_to
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        out = self.core(x)
+        if out.shape[-1] < self._pad_to:
+            out = F.pad(out, (0, self._pad_to - out.shape[-1]))
+        return out
+
+    def decay_weights(self, weight_decay: float, weight_boosting: bool = False) -> None:
+        if hasattr(self.core, "decay_weights"):
+            self.core.decay_weights(weight_decay, weight_boosting)
+
+    def apply_rewiring(self) -> None:
+        if hasattr(self.core, "apply_rewiring"):
+            self.core.apply_rewiring()
+
+
