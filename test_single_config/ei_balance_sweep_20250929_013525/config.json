{
    "experiment": {
        "seed": 0,
        "train_valid_split": 0.8,
        "enable_amp": false,
        "enable_profiling": false,
        "profiling_output_dir": "results/profiling/",
        "enable_hooks": true,
        "checkpointing": {
            "enabled": true,
            "save_every_n_epochs": 10,
            "checkpoint_dir": "experiments/dendritic_information_processing/results/checkpoints/"
        }
    },
    "data": {
        "dataset_name": "mnist",
        "base_dir": "/n/netscratch/bsabatini_lab/Everyone/mrichards/HS/",
        "processing": {
            "flatten": true,
            "normalize": false
        },
        "dataset_params": {
            "mnist_modulo10": {
                "shuffle_iterations": 2
            },
            "random_flip_mnist": {
                "flip_probability": 0.5
            },
            "poisson_generator": {
                "base_dataset": "mnist",
                "rate_multiplier": 1.0
            },
            "multixor": {
                "n_bits": 8
            },
            "orientation_bars": {
                "n_orient_classes": 8
            },
            "orthonet": {
                "input_dim": 784,
                "n_layers": 5,
                "nonlinearity": "sigmoid",
                "repeat_layers": false,
                "noise_std": 0.1
            }
        }
    },
    "model": {
        "task": "classification",
        "encoder": {
            "type": "identity",
            "params": {
                "input_dim": 784,
                "input_shape": [
                    784
                ]
            }
        },
        "core": {
            "type": "einet",
            "n_branch_layers": 1,
            "n_soma": 10,
            "architecture": {
                "excitatory_layer_sizes": [
                    10
                ],
                "inhibitory_layer_sizes": [
                    10
                ],
                "excitatory_branch_factors": [
                    1
                ],
                "inhibitory_branch_factors": [
                    1
                ]
            },
            "connectivity": {
                "ee_synapses_per_branch_per_layer": [
                    10
                ],
                "ei_synapses_per_branch_per_layer": [
                    1
                ],
                "ie_synapses_per_branch_per_layer": [
                    80
                ],
                "ii_synapses_per_branch_per_layer": [
                    0
                ]
            },
            "transfer": {
                "input_mode": 1,
                "independent_pathways": false,
                "excitatory_dim": null,
                "inhibitory_dim": null,
                "output_activation": null
            },
            "morphology": {
                "use_shunting": true,
                "weight_transform": "softplus"
            },
            "implementation": {
                "bias_init": "zeros",
                "weight_init": "xavier_uniform"
            },
            "sparsity": {
                "topk_mode": "standard",
                "stochastic_topk": false
            }
        },
        "decoder": {
            "type": "identity",
            "params": {
                "input_dim": null
            }
        }
    },
    "training": {
        "encoder": {
            "strategy": "standard",
            "common": {
                "epochs": 500,
                "batch_size": 512,
                "shuffle": true,
                "grad_clip_value": 5.0,
                "loss_function": "log_mse",
                "early_stopping": true,
                "patience": 100,
                "load_best_state_dict": true,
                "save_path": null,
                "plot_losses": false,
                "suppress_prints": false,
                "print_every": 10,
                "use_amp": false,
                "enable_nan_checking": false,
                "enable_adaptive_clipping": false,
                "weight_decay_rate": 0.01,
                "weight_boosting": false,
                "param_groups": {
                    "lr": 0.01,
                    "split_params": true,
                    "topk_lr": 0.001,
                    "blocklinear_lr": 0.0001,
                    "reactivation_lr": 0.0001,
                    "decoder_lr": 0.001
                }
            },
            "strategies": {
                "standard": {},
                "multi_stage": {
                    "analyze_between_stages": true,
                    "use_best_from_each_stage": true,
                    "continue_on_failure": false,
                    "stages": [
                        {
                            "learning_strategy": "standard",
                            "epochs": 100,
                            "batch_size": 512,
                            "save_checkpoint": false,
                            "param_groups": {
                                "lr": 0.01,
                                "split_params": true,
                                "topk_lr": 0.001,
                                "blocklinear_lr": 0.0001,
                                "reactivation_lr": 0.0001,
                                "decoder_lr": 0.001
                            },
                            "trainer_config": {
                                "loss_function": "ce",
                                "early_stopping": true,
                                "patience": 500
                            }
                        },
                        {
                            "learning_strategy": "local_ca",
                            "epochs": 100,
                            "batch_size": 512,
                            "reset_optimizer": false,
                            "save_checkpoint": false,
                            "param_groups": {
                                "lr": 0.0001,
                                "split_params": true,
                                "topk_lr": 0.0001,
                                "blocklinear_lr": 1e-05,
                                "reactivation_lr": 1e-05,
                                "decoder_lr": 0.001
                            },
                            "trainer_config": {
                                "loss_function": "ce",
                                "early_stopping": false
                            }
                        }
                    ]
                },
                "local_ca": {
                    "rule_variant": "4f",
                    "error_mode": "auto",
                    "error_broadcast_mode": "scalar",
                    "ema_alpha": 0.1,
                    "use_conductance_scaling": true,
                    "use_driving_force": true,
                    "theta": 0.0,
                    "e_rev_exc": 1.0,
                    "e_rev_inh": 0.0,
                    "clip_grad_value": 5.0,
                    "normalize_by_batch": false,
                    "phi_mode": "conditional",
                    "phi_ridge_lambda": 0.001,
                    "rho_estimator": "ema",
                    "phi_estimator": "conditional_ema",
                    "augment_k": 8,
                    "augment_noise_sigma": 0.01,
                    "rls_forgetting": 0.99,
                    "update_inactive_weights": false,
                    "hsic_enabled": true,
                    "hsic_weight": 0.01,
                    "hsic_self_weight": 0.3,
                    "hsic_target_weight": 0.3,
                    "hsic_target_source": "labels",
                    "hsic_kernel": "rbf",
                    "hsic_sigma": 1.0,
                    "hsic_degree": 2,
                    "hsic_coef0": 1.0,
                    "hsic_grad_clip_value": 0.1,
                    "hsic_warmup_epochs": 5,
                    "hsic_apply_last_layer_only": false,
                    "rho_mode": "dot",
                    "decoder_update_mode": "backprop",
                    "update_reactivation": true,
                    "freeze_reactivation_epochs": 20,
                    "freeze_decoder_epochs": 0,
                    "training_schedule": [],
                    "layer_wise_rho_scale": 0.0,
                    "layer_wise_phi_scale": 0.0
                },
                "voltage_stabilization": {
                    "pretrain_epochs": 100,
                    "stabilize_mode": "vout",
                    "freeze_reactivation": true,
                    "target_voltage": 0.5,
                    "loss_metric": "mse"
                },
                "homeostatic_control": {
                    "pretrain_epochs": 100,
                    "stabilize_mode": "vinf",
                    "freeze_reactivation": false,
                    "target_voltage": 0.5,
                    "loss_metric": "mse"
                },
                "freeze_layers": {
                    "pretrain_epochs": 10,
                    "reverse_training": false,
                    "epochs_per_layer": 50,
                    "final_tune_epochs": 10
                },
                "freeze_branches": {
                    "pretrain_epochs": 10,
                    "reverse_training": false,
                    "epochs_per_branch": 50,
                    "final_tune_epochs": 10
                },
                "freeze_branch_kl": {
                    "pretrain_epochs": 10,
                    "reverse_training": false,
                    "epochs_per_branch": 50,
                    "final_tune_epochs": 10,
                    "kl_weight": 0.1
                }
            }
        },
        "main": {
            "strategy": "standard",
            "common": {
                "epochs": 60,
                "batch_size": 128,
                "shuffle": true,
                "grad_clip_value": 5.0,
                "loss_function": "cat_nll",
                "early_stopping": true,
                "patience": 20,
                "load_best_state_dict": true,
                "save_path": null,
                "plot_losses": false,
                "suppress_prints": false,
                "print_every": 10,
                "use_amp": false,
                "enable_nan_checking": false,
                "enable_adaptive_clipping": false,
                "weight_decay_rate": 0.0,
                "weight_boosting": false,
                "param_groups": {
                    "lr": 0.001,
                    "split_params": false,
                    "topk_lr": 0.001,
                    "blocklinear_lr": 0.0001,
                    "reactivation_lr": 0.0001,
                    "decoder_lr": 0.001
                }
            },
            "regularization": {
                "l1_weight": 0.0,
                "l2_weight": 0.0,
                "selective": {
                    "layers": [],
                    "branches": []
                }
            },
            "pruning": {
                "enabled": false
            }
        }
    },
    "analysis": {
        "performance_analysis": {
            "enabled": true,
            "training": true,
            "params": {
                "accuracy": true,
                "auc": true,
                "categorical_loglikelihood": true
            }
        },
        "synapse_turnover_analysis": {
            "enabled": false,
            "training": false,
            "params": {
                "snapshot_interval": 1,
                "synaptic_analysis": true,
                "save_synaptic_report": true
            }
        },
        "noise_perturbation_analysis": {
            "enabled": false,
            "training": false,
            "params": {
                "uniform_noise": true,
                "uniform_magnitudes": [
                    0.1,
                    0.2
                ],
                "gaussian_noise": true,
                "gaussian_sdevs": [
                    0.1,
                    0.2
                ],
                "n_samples": 10,
                "accuracy": true,
                "auc": true,
                "categorical_loglikelihood": true,
                "mse": true,
                "cosine_similarity": true
            }
        },
        "single_layer_contribution": {
            "enabled": false,
            "training": false,
            "params": {
                "excitation_contribution": true,
                "inhibition_contribution": true,
                "both_contribution": true,
                "accuracy": true,
                "auc": true,
                "categorical_loglikelihood": true,
                "mse": true,
                "cosine_similarity": true
            }
        },
        "ablation_analysis": {
            "enabled": false,
            "training": false,
            "params": {
                "layer_ablation": true,
                "compartment_ablation": true,
                "ablate_all_synapses": true,
                "ablate_excitation": true,
                "ablate_inhibition": true,
                "ablate_upstream": true,
                "accuracy": true,
                "auc": true,
                "categorical_loglikelihood": true,
                "mse": true,
                "cosine_similarity": true
            }
        },
        "weight_analysis": {
            "enabled": true,
            "training": false,
            "params": {
                "synapse_weights": true,
                "computation_level": "single_branch",
                "analyze_excitatory": true,
                "analyze_inhibitory": true,
                "compute_mean": true
            }
        },
        "compartment_statistics_analysis": {
            "enabled": true,
            "training": false,
            "params": {
                "synapse_weights": true,
                "branch_weights": true,
                "inputs": true,
                "activations": true,
                "global_analysis": true,
                "layer_analysis": true,
                "branch_analysis": true,
                "compute_mean": true,
                "compute_variance": true,
                "compute_percentiles": true,
                "compute_min_max": true,
                "compute_entropy": true,
                "per_class_analysis": false,
                "n_samples": null
            }
        },
        "synaptic_activation_analysis": {
            "enabled": false,
            "training": false,
            "params": {
                "network_summary": true,
                "layer_summary": true,
                "branch_summary": true,
                "raw_summary": true,
                "logspace": false,
                "downsample": true,
                "samples": 5
            }
        },
        "branch_activation_analysis": {
            "enabled": false,
            "training": false,
            "params": {
                "synapse_activations": true,
                "branch_activations": true,
                "network_summary": true,
                "layer_summary": true,
                "branch_summary": true,
                "raw_summary": true,
                "logspace": false,
                "downsample": true,
                "samples": 5
            }
        },
        "information_analysis": {
            "enabled": true,
            "training": false,
            "params": {
                "method": "kraskov",
                "max_samples": 1000,
                "n_neighbors": 10,
                "compute_basic_mi": true,
                "include_vinf": true,
                "normalize_mi": false,
                "verbose": false,
                "computation_level": "single_branch"
            }
        },
        "correlation_analysis": {
            "enabled": true,
            "training": false,
            "params": {
                "computation_level": "single_branch",
                "analyze_EE": true,
                "analyze_II": true,
                "analyze_EI": true,
                "max_samples": 1000
            }
        }
    },
    "wandb": {
        "use_wandb": false,
        "entity": "",
        "project": "dendritic-sweeps",
        "group": "unified_sweep",
        "tags": [
            "debug"
        ],
        "enabled": true,
        "log_freq": 100,
        "log_gradients": false,
        "log_parameters": false,
        "log_activations": false
    },
    "outputs": {
        "run_name": "ei_balance_sweep",
        "results_dir": "test_single_config"
    },
    "fsdp": {
        "use_fsdp": false,
        "sharding_strategy": "FULL_SHARD",
        "mixed_precision": true,
        "cpu_offload": false,
        "min_num_params": 1000000,
        "reduce_communication_overhead": true,
        "limit_all_gathers": true,
        "forward_prefetch": true,
        "sync_module_states": true,
        "use_orig_params": true,
        "backward_prefetch": "BACKWARD_PRE",
        "gradient_checkpointing": false
    }
}
